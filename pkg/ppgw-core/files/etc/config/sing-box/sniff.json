{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:82",
      "external_ui": "/etc/config/clash/clash-dashboard",
      "secret": "paopaogateway",
      "default_mode": "rule"
    }
  },
  "inbounds": [
    {
      "type": "tproxy",
      "tag": "sniff",
      "listen": "127.0.0.1",
      "listen_port": 1081,
      "sniff": true,
      "sniff_override_destination": true,
      "sniff_timeout": "300ms"
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "clash",
      "server": "127.0.0.1",
      "server_port": 1080,
      "version": "5",
      "domain_strategy": ""
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "rules": [
      {
        "protocol": "bittorrent",
        "outbound": "block"
      },
      {
        "outbound": "clash"
      }
    ],
    "final": "clash"
  }
}
